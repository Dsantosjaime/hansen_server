// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  keycloakId String   @unique
  email      String?
  name       String?

  roleId     String? @db.ObjectId
  role       Role?   @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

type Permission {
  subject String // "Post"
  action  String // "create"
}

type PermissionSubGroup {
  name          String
  permissions   Permission[]
}

model PermissionGroup {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  name                String   @unique
  permissionSubGroup  PermissionSubGroup[]
}

model Role {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  permissions Permission[]

  isSystem    Boolean      @default(false)

  users       User[]
  @@index([name])
}

model Group {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  subGroups SubGroup[]
}

model SubGroup {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  name    String

  groupId String @db.ObjectId
  group   Group  @relation(fields: [groupId], references: [id])

  brevoListId Int? 

  @@index([groupId])
}

enum ContactStatus {
  NO_EXCHANGE
  MET
  CLIENT
  UNDESIRABLE
}

model Contact {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  firstName   String
  lastName    String
  function    String
  status      ContactStatus @default(NO_EXCHANGE)
  email       String @unique
  phoneNumber String[]
  lastContact String
  lastEmail   String
  groupId     String @db.ObjectId
  subGroupId  String @db.ObjectId

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

type EmailSendSubGroup {
  subGroupId      String   @db.ObjectId
  subGroupName    String
  from            DateTime?
  recipientsCount Int
}

type EmailSendGroup {
  groupId    String @db.ObjectId
  groupName  String
  subGroups  EmailSendSubGroup[]
}

model EmailSend {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId

  // 1 doc par campagne provider (run)
  brevoCampaignId String   @unique

  // Pour pouvoir dédupliquer “nouveaux contacts” par template
  templateId      Int

  name            String?
  subject         String
  status          String

  // Ciblage enregistré (pour affichage + historique)
  affected        EmailSendGroup[]

  // ciblage "plat" (requêtes rapides)
  affectedGroupIds    String[] @db.ObjectId
  affectedSubGroupIds String[] @db.ObjectId

  recipientsCount Int?
  // listIds “logiques” (listes des sous-groupes ciblés, pour info)
  listIds         Int[]
  // listId réellement utilisé pour l’envoi (temp)
  tempListId      Int?

  scheduledAt     DateTime?

  // timestamps globaux
  sentAt          DateTime?
  deliveredAt     DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  bouncedAt       DateTime?
  unsubscribedAt  DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([templateId])
}

model TemplateSubGroupCursor {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  templateId Int
  subGroupId String   @db.ObjectId
  lastSentAt DateTime

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([templateId, subGroupId])
  @@index([templateId])
  @@index([subGroupId])
}

model CampaignAttachment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  token      String   @unique
  filename   String
  mimeType   String
  size       Int
  path       String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
}

enum ToDoType {
  REMINDER
  SERVICE
}

model ToDo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  contactId String  @db.ObjectId
  type      ToDoType
  title     String
  toDoAt    DateTime
  done      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PluginRestrictedParamType {
  FUNCTION
  NAME
}

model PluginParam {
  id   String                    @id @default(auto()) @map("_id") @db.ObjectId
  name String
  type PluginRestrictedParamType
}

model EmailAddressTemplate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  pattern     String   // pattern du local-part (avant @)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
